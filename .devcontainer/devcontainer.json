{
  "name": "Booking SaaS (Laravel)",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/sshd:1": { "version": "latest" }
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "الموقع", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "nohup php artisan serve --host=0.0.0.0 --port=8000 > storage/logs/serve.log 2>&1 &",
  "customizations": {
    "vscode": {
      "extensions": ["bmewburn.vscode-intelephense-client", "onecentlab.laravel-blade", "bradlc.vscode-tailwindcss"]
    }
  }
}
